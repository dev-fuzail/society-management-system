<!DOCTYPE html>
<html>
  <head>
    <title>Admin Dashboard</title>
    <style>
      /* (Add your CSS styles here, or link a static CSS file) */
      body {
        font-family: sans-serif;
        background-color: #f8f8f8;
        margin: 0;
        padding: 0;
      }
      header {
        background-color: #075e54;
        color: white;
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .container {
        padding: 40px 20px;
        max-width: 1200px;
        margin: auto;
      }
      .data-table th,
      .data-table td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
      }
    </style>
  </head>
  <body>
    <header>
      <h1>Admin Dashboard</h1>
      <a href="/admin-login" style="color: white">Logout</a>
    </header>

    <div class="container">
      <h3>System Overview</h3>
      <div class="stats-grid">
        <div class="stat-box">
          <h3>Total Societies</h3>
          <p><%= societyCount %></p>
        </div>
        <div class="stat-box">
          <h3>Total Platform Users</h3>
          <p><%= totalUsersCount %></p>
        </div>
      </div>

      <h3 style="margin-top: 40px">Societies List</h3>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>City</th>
            <th>Total Apartments</th>
            <th>Total Users</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% societies.forEach(society => { %>
          <tr>
            <td><%= society.name %></td>
            <td><%= society.city %></td>
            <td><%= society.total_apartments %></td>
            <td><%= society.membersCount %></td>
            <td class="status-cell">
              <span
                style=`color: <%= society.status === 'active' ? 'green' : 'red' %>;`
              >
                <%= society.status %>
              </span>
            </td>
            <td>
              <button
                data-society-id="<%= society._id %>"
                data-current-status="<%= society.status %>"
                class="status-toggle-btn"
              >
                <%= society.status === 'active' ? 'Disable' : 'Activate' %>
              </button>

              <button
                data-society-id="<%= society._id %>"
                data-society-name="<%= society.name %>"
                class="delete-society-btn"
                style="
                  background-color: #ff3b30;
                  color: white;
                  border: none;
                  padding: 5px 10px;
                  margin-left: 8px;
                  cursor: pointer;
                  border-radius: 4px;
                "
              >
                Delete
              </button>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const buttons = document.querySelectorAll(".status-toggle-btn");

        buttons.forEach((button) => {
          button.addEventListener("click", async (event) => {
            const button = event.currentTarget;
            const societyId = button.getAttribute("data-society-id");
            const currentStatus = button.getAttribute("data-current-status");

            // Determine the new status
            const newStatus =
              currentStatus === "active" ? "disabled" : "active";
            const actionText =
              newStatus === "disabled" ? "Disable" : "Activate";

            if (
              !confirm(`Are you sure you want to ${actionText} this society?`)
            ) {
              return;
            }

            // Show a loading state on the button
            button.disabled = true;
            button.textContent = "Updating...";

            try {
              // 1. Construct the URL and send the request
              const response = await fetch(
                `/admin/society/${societyId}/status`,
                {
                  method: "POST",
                  headers: {
                    "Content-Type": "application/json",
                    // NOTE: Since this is secured by a session cookie (isAdminAuthenticated middleware),
                    // no Authorization header is needed.
                  },
                  body: JSON.stringify({ newStatus: newStatus }),
                }
              );

              const result = await response.json();

              if (response.ok && result.success) {
                // 2. Successful update: Update the UI elements
                const row = button.closest("tr"); // Find the nearest table row
                const statusCell = row.querySelector(".status-cell"); // Select the status cell (we need to add a class in EJS)

                // Update the button text, data attribute, and cell color/text
                button.setAttribute("data-current-status", newStatus);
                button.textContent =
                  newStatus === "active" ? "Disable" : "Activate";

                if (statusCell) {
                  statusCell.textContent = newStatus;
                  statusCell.style.color =
                    newStatus === "active" ? "green" : "red";
                }

                alert(`Society updated to ${newStatus}.`);
              } else {
                alert(`Error: ${result.message || "Failed to update status."}`);
              }
            } catch (error) {
              console.error("AJAX Error:", error);
              alert("An error occurred while communicating with the server.");
            } finally {
              // 3. Restore button state
              button.disabled = false;
              // If an error occurred, the button text remains "Updating..." so we restore it based on the data attribute
              if (button.textContent === "Updating...") {
                button.textContent =
                  button.getAttribute("data-current-status") === "active"
                    ? "Disable"
                    : "Activate";
              }
            }
          });
        });

        const deleteButtons = document.querySelectorAll(".delete-society-btn");

        deleteButtons.forEach((button) => {
          button.addEventListener("click", async (event) => {
            const button = event.currentTarget;
            const societyId = button.getAttribute("data-society-id");
            const societyName = button.getAttribute("data-society-name");
            const row = button.closest("tr"); // Get the table row for UI removal

            // ⚠️ Critical Confirmation Step
            if (
              !confirm(
                `⚠️ WARNING: This will permanently delete the society "${societyName}" and ALL associated users (${row.cells[3].textContent}). Are you absolutely sure?`
              )
            ) {
              return;
            }

            button.disabled = true;
            button.textContent = "Deleting...";

            try {
              const response = await fetch(
                `/admin/society/${societyId}/delete`,
                {
                  method: "POST",
                  headers: { "Content-Type": "application/json" },
                }
              );

              const result = await response.json();

              if (response.ok && result.success) {
                // Successful deletion: Remove the row from the table (UI update)
                row.remove();
                alert(result.message);
              } else {
                alert(
                  `Error: ${result.message || "Failed to delete society."}`
                );
              }
            } catch (error) {
              console.error("AJAX Error:", error);
              alert("An error occurred during deletion.");
            } finally {
              // If deletion failed, restore the button state
              if (button.textContent === "Deleting...") {
                button.textContent = "Delete";
                button.disabled = false;
              }
            }
          });
        });
      });
    </script>
  </body>
</html>
